{
  "name": "shop-afrik-functions",
  "version": "0.1.0",
  "description": "Cloud Functions for Shop Afrik — orders, payments, refunds, settlement.",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
