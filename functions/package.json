{
  "name": "shop-afrik-functions",
  "version": "0.1.0",
  "description": "Cloud Functions for Shop Afrik — orders, payments, refunds, settlement.",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint --ext .ts src",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "firebase emulators:exec --only auth,firestore --project demo-shop-afrik \"jest\"",
    "test:unit": "jest test/unit"
  },
  "dependencies": {
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^5.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "firebase": "^10.14.1",
    "firebase-functions-test": "^3.5.0",
    "firebase-tools": "^13.35.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.5.3"
  },
  "private": true
}
