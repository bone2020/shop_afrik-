rules_version = '2';

// Shop Afrik Firestore security rules.
//
// Roles are carried in custom auth claims (`role`, `adminTier`) set by the
// `setUserRole` Cloud Function. Money-critical writes (orders, settlements,
// refund decisions, audit) go exclusively through Cloud Functions, which use
// the Admin SDK and bypass these rules — so those paths are read-only (or
// closed) to clients here. See functions/src for the write paths.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return isSignedIn() ? request.auth.token.role : '';
    }
    function isAdmin() {
      return role() == 'admin';
    }
    function isSeller() {
      return role() == 'seller';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // True if only the named fields changed between the old and new docs.
    // Email accounts must have verified their address (SA-102); phone
    // accounts carry no email claim.
    function hasVerifiedContact() {
      return !('email' in request.auth.token)
             || request.auth.token.email_verified == true;
    }
    // The calling seller's own store profile.
    function sellerProfile() {
      return get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data;
    }
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(fields);
    }

    // ---- categories ----
    // Public catalog taxonomy; only admins manage it.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- products ----
    match /products/{productId} {
      // Approved+active products are public; sellers see their own; admins all.
      allow read: if (resource.data.approvalStatus == 'approved'
                      && resource.data.isActive == true)
                  || isAdmin()
                  || isOwner(resource.data.sellerId);

      // A seller creates products under their own id, always starting as
      // pending and not pre-rating themselves.
      allow create: if isSeller()
                    && isOwner(request.resource.data.sellerId)
                    && request.resource.data.market == sellerProfile().market
                    && sellerProfile().approvalStatus == 'approved'
                    && request.resource.data.approvalStatus == 'pending'
                    && request.resource.data.ratingAverage == 0
                    && request.resource.data.ratingCount == 0;

      // Sellers may edit their own product but cannot self-approve or change
      // their ratings. Admins can moderate freely.
      allow update: if isAdmin()
                    || (isSeller()
                        && isOwner(resource.data.sellerId)
                        && request.resource.data.sellerId == resource.data.sellerId
                        && request.resource.data.get('market', '') == resource.data.get('market', '')
                        && sellerProfile().approvalStatus == 'approved'
                        && request.resource.data.approvalStatus == resource.data.approvalStatus
                        && request.resource.data.ratingAverage == resource.data.ratingAverage
                        && request.resource.data.ratingCount == resource.data.ratingCount
                        && request.resource.data.get('hasOrders', false) == resource.data.get('hasOrders', false)
                        && request.resource.data.get('archived', false) == resource.data.get('archived', false));

      // Sellers remove products through removeProduct, which archives any
      // product that has been ordered (SA-044).
      allow delete: if false;
    }

    // ---- sellers ----
    // Private to the seller and admins (SA-141). The public store profile
    // is `stores/{sellerId}`, copied from here by syncStoreProfile.
    match /sellers/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow create: if isOwner(sellerId)
                    && hasVerifiedContact()
                    && request.resource.data.kycStatus == 'notStarted'
                    && request.resource.data.approvalStatus == 'pending';
      // Owners edit profile fields only; KYC/approval/ratings are admin- or
      // server-controlled.
      allow update: if isAdmin()
                    || (isOwner(sellerId)
                        && request.resource.data.kycStatus == resource.data.kycStatus
                        && request.resource.data.approvalStatus == resource.data.approvalStatus
                        && request.resource.data.ratingAverage == resource.data.ratingAverage
                        && request.resource.data.ratingCount == resource.data.ratingCount);
      allow delete: if isAdmin();
    }

    // ---- stores ----
    match /stores/{sellerId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- buyers ----
    match /buyers/{buyerId} {
      allow read: if isOwner(buyerId) || isAdmin();
      allow create, update: if isOwner(buyerId);
      allow delete: if isAdmin();
    }

    // ---- orders ----
    // Created and advanced only by Cloud Functions. Clients read their own;
    // a courier reads only orders assigned to them, and only once shipped, so
    // buyer contact details are not exposed before they are out for delivery.
    match /orders/{orderId} {
      allow read: if isAdmin()
                  || isOwner(resource.data.buyerId)
                  || (isSeller() && request.auth.uid in resource.data.sellerIds)
                  || (role() == 'delivery'
                      && resource.data.get('courierId', '') == request.auth.uid
                      && resource.data.status in ['shipped', 'delivered']);
      allow write: if false;
    }

    // ---- reviews ----
    match /reviews/{reviewId} {
      allow read: if true;
      // Written only by submitReview / deleteReview, which check for a
      // delivered order line and recompute ratings (SA-111).
      allow write: if false;
    }

    // ---- refund_requests ----
    match /refund_requests/{refundId} {
      allow read: if isAdmin()
                  || isOwner(resource.data.buyerId)
                  || (isSeller()
                      && request.auth.uid in resource.data.get('sellerIds', []));
      // Created by the requestRefund function (which computes the amount and
      // checks the window); decisions go through decideRefund.
      allow write: if false;
    }

    // ---- settlements ----
    // Entirely server-managed; sellers and admins may read.
    match /settlements/{settlementId} {
      allow read: if isAdmin() || isOwner(resource.data.sellerId);
      allow write: if false;
    }

    // ---- notifications ----
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.recipientId) || isAdmin();
      // Recipients may only flip the read flag; everything else is server-side.
      allow update: if isOwner(resource.data.recipientId)
                    && onlyChanged(['isRead']);
      allow create, delete: if false;
    }

    // ---- admin_audit ----
    // Append-only and server-written; never mutated or deleted.
    match /admin_audit/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- staff ----
    // Directory of admins and couriers, written only by setUserRole.
    match /staff/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- platform settings ----
    // Changed only through updatePlatformSettings, which validates and
    // audits every edit (SA-133).
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- platform account mirror ----
    // Shop Afrik's own record of the three buckets per currency, its ledger,
    // and reconciliation runs. Server-written (Cloud Functions); admins read.
    match /platform_balances/{currency} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /platform_ledger/{moveId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /reconciliations/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
